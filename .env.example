# URL pública do projeto. Não inclua barra no final.
APP_URL=http://localhost:5199

# Use uma sequência aleatória longa. Nunca use este valor de exemplo em produção.
SESSION_SECRET=replace_with_at_least_32_random_characters
TOKEN_ENCRYPTION_KEY=replace_with_a_32_byte_encryption_key

# Meta: Instagram profissional, Facebook Pages, Messenger e WhatsApp Cloud API.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URI=https://seu-dominio.com/api/oauth/meta/callback
META_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Google / YouTube Data e Analytics APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio.com/api/oauth/google/callback

# TikTok Login Kit, Content Posting e Display APIs.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://seu-dominio.com/api/oauth/tiktok/callback

# Banco persistente recomendado para tokens, contas, posts e métricas.
DATABASE_URL=

